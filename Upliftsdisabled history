<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Important Figures</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f5f5f5;
        }

        header {
            background: #1a1a1a;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
        }

        .figure-card {
            background: white;
            padding: 20px;
            margin-bottom: 25px;
            border-radius: 10px;
            display: flex;
            gap: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .figure-card img {
            width: 180px;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
        }

        .figure-content h2 {
            margin: 0 0 10px;
        }

        .figure-content p {
            line-height: 1.5;
        }
    </style>
</head>

<body>
    <header>
        <h1 id="mainTitle">Important Figures</h1>
    </header>

    <div class="container" id="figuresContainer"></div>

    <script>
        // Editable keyword-based content
        const websiteData = {
            mainTitle: "Influential Leaders Throughout History",

            figures: [
                {
                    title: "Albert Einstein",
                    image: "https://upload.wikimedia.org/wikipedia/commons/d/d3/Albert_Einstein_Head.jpg",
                    text: "A theoretical physicist known for developing the theory of relativity."
                },
                {
                    title: "Marie Curie",
                    image: "https://upload.wikimedia.org/wikipedia/commons/6/69/Marie_Curie_c1920.png",
                    text: "A pioneering scientist in radioactivity and the first woman to win a Nobel Prize."
                },
                {
                    title: "Nelson Mandela",
                    image: "https://upload.wikimedia.org/wikipedia/commons/0/0d/Nelson_Mandela-2008_%28edit%29.jpg",
                    text: "A global symbol of peace and justice who fought against apartheid in South Africa."
                }
            ]
        };

        // Render website content dynamically
        document.getElementById("mainTitle").innerText = websiteData.mainTitle;

        const container = document.getElementById("figuresContainer");

        websiteData.figures.forEach(fig => {
            const card = document.createElement("div");
            card.className = "figure-card";

            card.innerHTML = `
                <img src="${fig.image}" alt="${fig.title}">
                <div class="figure-content">
                    <h2>${fig.title}</h2>
                    <p>${fig.text}</p>
                </div>
            `;

            container.appendChild(card);
        });
    </script>
</body>
</html>
